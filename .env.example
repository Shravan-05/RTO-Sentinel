# RTO Sentinel — Environment Configuration
# Copy this file to .env and fill in your values.
# Required for production. Optional fields have safe defaults for local development.

# ============================================================
# SERVER
# ============================================================
NODE_ENV=development
PORT=4000

# ============================================================
# AUTHENTICATION
# Generate a secure random secret: openssl rand -hex 32
# ============================================================
JWT_SECRET=rto-sentinel-dev-secret-key-change-in-production-abc123xyz789
JWT_EXPIRES_IN=7d

# ============================================================
# DATABASE
# Leave empty or omit to auto-fall back to local JSON store
# (MongoDB is optional — app runs fully without it)
# ============================================================
MONGODB_URI=mongodb://localhost:27017/rto_sentinel

# ============================================================
# AI ENGINE (FastAPI Python service)
# Start with: uvicorn app.main:app --reload --port 8000
# ============================================================
AI_ENGINE_URL=http://127.0.0.1:8000/api/v1

# ============================================================
# GEMINI API KEY (Optional - for LLM address validation)
# Free tier at: https://aistudio.google.com/apikey
# If not provided, rule-based address validator is used automatically
# ============================================================
GEMINI_API_KEY=

# ============================================================
# FRONTEND (Vite dev server — typically not needed in .env)
# ============================================================
VITE_API_BASE_URL=http://localhost:4000/api/v1

